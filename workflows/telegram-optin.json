    {
      "parameters": {
        "jsCode": "const r = $('Resolve Bind').first().json;\nconst resp = $json || {};\nconst cp = resp.course_progress || {};\nconst pct = cp.percent_complete !== undefined && cp.percent_complete !== null\n  ? Number(cp.percent_complete)\n  : Number(r.percent_complete || 0);\n\nfunction esc(s) {\n  return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n\nfunction ar(n) {\n  const d = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];\n  const s = String(n);\n  let o = '';\n  for (let i = 0; i < s.length; i++) {\n    const c = s.charAt(i);\n    o += (c >= '0' && c <= '9') ? d[Number(c)] : c;\n  }\n  return o;\n}\n\nconst raw = String(r.full_name || r.first_name || '').trim();\nconst name = esc(raw.split(' ')[0] || 'صديقنا');\n\nlet line;\nif (pct === 0) {\n  line = 'ما بدأت الدورة بعد — أول درس ما ياخذ منك أكثر من عشر دقايق.';\n} else if (pct >= 100) {\n  line = 'خلصت الدورة كاملة 🎉 عساك على القوة.';\n} else {\n  line = 'أنجزت ' + ar(pct) + '٪ من الدورة إلى الآن.';\n}\n\nconst text = 'هلا ' + name + ' 👋\\n\\n'\n  + 'ربطنا حسابك بنجاح ✅\\n'\n  + line + '\\n\\n'\n  + 'انضم لقناة الطلاب من هنا:\\n'\n  + r.channel_link + '\\n\\n'\n  + 'بنرسل لك تحديث قصير عن تقدّمك كل فترة عشان تكمل دورتك 💪\\n'\n  + 'لا إشارات ولا توصيات — متابعة تقدّم فقط.';\n\nreturn [{ json: { chat_id: r.chat_id, text: text, percent_complete: pct, row_id: r.row_id } }];\n"
      },
