    {
      "parameters": {
        "jsCode": "const msg = $('Classify Message').first().json;\nconst cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id !== undefined);\n\nconst testMode = String(cfg.test_mode) === 'true';\nconst allow = String(cfg.test_chat_ids || '').split(',').map(s => s.trim()).filter(Boolean);\n\nfunction out(outcome, extra) {\n  return [{ json: Object.assign({}, msg, { outcome: outcome, channel_link: cfg.channel_link }, extra || {}) }];\n}\n\nif (testMode && allow.indexOf(msg.chat_id) === -1) {\n  return out('ignored_not_allowlisted', { note: 'TEST MODE: add this chat_id to Config.test_chat_ids to enable replies' });\n}\n\nconst bound = rows.find(r => String(r.telegram_chat_id || '') === msg.chat_id && r.status !== 'unmatched');\nif (bound) {\n  return out('already_bound', { row_id: bound.id, full_name: bound.full_name, teachable_user_id: bound.teachable_user_id });\n}\n\nif (msg.kind === 'start') return out('ask_email');\nif (msg.kind !== 'email') return out('help');\n\nconst unmatched = rows.find(r => String(r.telegram_chat_id || '') === msg.chat_id && r.status === 'unmatched');\nconst attempts = unmatched ? Number(unmatched.bind_attempts || 0) : 0;\nif (attempts >= 3) return out('too_many_attempts');\n\nconst match = rows.find(r => String(r.email_norm || '').toLowerCase() === msg.email_norm && r.status !== 'unmatched');\nif (!match) {\n  return out('not_found', { next_attempts: attempts + 1 });\n}\nif (String(match.telegram_chat_id || '') !== '') {\n  return out('already_taken');\n}\n\nreturn out('bind_ok', {\n  row_id: match.id,\n  teachable_user_id: match.teachable_user_id,\n  full_name: match.full_name,\n  batch: match.batch,\n  percent_complete: Number(match.percent_complete || 0)\n});\n"
      },
