        "jsCode": "const c = $('Compute Member State').item.json;\nconst resp = $json || {};\nconst ok = resp.ok === true || Boolean(resp.result && resp.result.message_id);\n\nlet status = 'ok';\nlet err = '';\nif (!ok) {\n  let msg = '';\n  try { msg = String(resp.error || resp.message || JSON.stringify(resp)); } catch (e) { msg = 'unknown error'; }\n  err = msg.slice(0, 300);\n  status = /403|blocked|bot was blocked|chat not found|user is deactivated|deactivated/i.test(msg) ? 'blocked' : 'error';\n}\n\nreturn { json: {\n  row_id: c.row_id,\n  chat_id: c.chat_id,\n  ok: ok,\n  dm_status: status,\n  last_error: err,\n  new_dm_count: ok ? c.dm_count + 1 : c.dm_count,\n  percent_complete: c.percent_complete\n}};\n"
      },
