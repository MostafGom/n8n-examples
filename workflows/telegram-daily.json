      "id": "570faf1c-fb2e-4b32-9305-1b039812995a",
      "name": "Reload Members For Totals",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -656,
        112
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst batchRows = $('Load Batches').all().map(i => i.json).filter(b => b && b.batch);\nconst members = $input.all().map(i => i.json).filter(r => r && r.id !== undefined && r.teachable_user_id);\n\nconst today = new Date().toISOString().slice(0, 10);\nconst onlyOnChange = String(cfg.post_only_on_change) === 'true';\nconst out = [];\n\nfunction ar(n) {\n  const d = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];\n  const s = String(n);\n  let o = '';\n  for (let i = 0; i < s.length; i++) {\n    const c = s.charAt(i);\n    o += (c >= '0' && c <= '9') ? d[Number(c)] : c;\n  }\n  return o;\n}\n\nfor (const b of batchRows) {\n  if (b.channel_post_active !== true) continue;\n  if (b.last_post_on && String(b.last_post_on).slice(0, 10) === today) continue;\n\n  const mine = members.filter(m => m.batch === b.batch && m.status !== 'unmatched' && m.status !== 'gone');\n  const total = mine.length;\n  if (total === 0) continue;\n\n  const started = mine.filter(m => Number(m.percent_complete || 0) > 0).length;\n  const halfway = mine.filter(m => Number(m.percent_complete || 0) >= 50).length;\n  const finished = mine.filter(m => m.ever_finished === true).length;\n  const linked = mine.filter(m => String(m.telegram_chat_id || '') !== '').length;\n\n  if (onlyOnChange\n      && started === Number(b.started_count || 0)\n      && finished === Number(b.finished_count || 0)\n      && total === Number(b.total_members || 0)) continue;\n\n  const text = 'متابعة تقدّم دفعة ' + (b.label || b.batch) + ' 📊\\n\\n'\n    + 'بدأوا الدورة: ' + ar(started) + ' من ' + ar(total) + '\\n'\n    + 'تجاوزوا نص الدورة: ' + ar(halfway) + '\\n'\n    + 'خلّصوا الدورة كاملة: ' + ar(finished) + '\\n\\n'\n    + 'كل يوم في ناس تخلّص — لا تخليها تفوتك 💪';\n\n  out.push({ json: {\n    batch: b.batch, row_id: b.id, text: text, channel_id: cfg.channel_id,\n    total: total, started: started, halfway: halfway, finished: finished, linked: linked,\n    post_date: today\n  }});\n}\n\nreturn out;\n"
      },
