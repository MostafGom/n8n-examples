    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst batchRows = $('Load Batches').all().map(i => i.json).filter(b => b && b.batch);\nconst members = $input.all().map(i => i.json).filter(r => r && r.id !== undefined && r.teachable_user_id);\n\nconst byBatch = {};\nfor (const b of batchRows) byBatch[b.batch] = b;\n\nconst out = [];\nfor (const m of members) {\n  const b = byBatch[m.batch];\n  if (!b) continue;\n  if (m.status === 'unmatched' || m.status === 'gone') continue;\n  out.push({ json: {\n    row_id: m.id,\n    teachable_user_id: Number(m.teachable_user_id),\n    full_name: m.full_name || '',\n    batch: m.batch,\n    batch_dm_active: b.dm_active === true,\n    dm_enabled: m.dm_enabled === true,\n    telegram_chat_id: String(m.telegram_chat_id || ''),\n    dm_status: m.dm_status || 'ok',\n    dm_count: Number(m.dm_count || 0),\n    dm_optin_at: m.dm_optin_at || null,\n    last_dm_at: m.last_dm_at || null,\n    stored_percent: Number(m.percent_complete || 0),\n    prev_percent: Number(m.prev_percent || 0),\n    stored_ever_finished: m.ever_finished === true\n  }});\n}\n\nout.sort(function (a, b) {\n  const at = a.json.last_dm_at ? new Date(a.json.last_dm_at).getTime() : 0;\n  const bt = b.json.last_dm_at ? new Date(b.json.last_dm_at).getTime() : 0;\n  return at - bt;\n});\n\nconst cap = Number(cfg.max_members_per_run || 300);\nif (out.length > cap) {\n  console.log('CAPPED: ' + out.length + ' members in tracked batches, processing ' + cap + ' this run; the rest roll to tomorrow');\n}\nreturn out.slice(0, cap);\n"
      },
