      "id": "90a76cac-e1c8-4342-b17e-551997fbe848",
      "name": "Get Course Progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -656,
        528
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $('Loop Over Members').item.json;\nconst cfg = $('Config').first().json;\nconst resp = $json || {};\nconst cp = resp.course_progress || {};\n\nfunction esc(s) {\n  return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n\nfunction ar(n) {\n  const d = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];\n  const s = String(n);\n  let o = '';\n  for (let i = 0; i < s.length; i++) {\n    const c = s.charAt(i);\n    o += (c >= '0' && c <= '9') ? d[Number(c)] : c;\n  }\n  return o;\n}\n\nconst fetched = cp.percent_complete !== undefined && cp.percent_complete !== null;\nconst pct = fetched ? Number(cp.percent_complete) : Number(m.stored_percent || 0);\nconst finishedNow = Boolean(cp.completed_at) || pct === 100;\nconst everFinished = Boolean(m.stored_ever_finished) || finishedNow;\n\nconst nowMs = new Date().getTime();\nconst cadenceMs = Number(cfg.cadence_h || 72) * 3600000;\nconst graceMs = Number(cfg.optin_grace_h || 48) * 3600000;\nconst maxCount = Number(cfg.max_dm_count || 8);\nconst dryRun = String(cfg.dry_run) === 'true';\n\nlet eligible = true;\nlet why = 'eligible';\nif (!m.batch_dm_active) { eligible = false; why = 'batch_dm_inactive'; }\nelse if (!m.dm_enabled) { eligible = false; why = 'dm_disabled'; }\nelse if (!m.telegram_chat_id) { eligible = false; why = 'not_linked'; }\nelse if (m.dm_status === 'blocked') { eligible = false; why = 'blocked'; }\nelse if (everFinished) { eligible = false; why = 'already_finished'; }\nelse if (Number(m.dm_count || 0) >= maxCount) { eligible = false; why = 'dm_cap_reached'; }\nelse if (!m.dm_optin_at) { eligible = false; why = 'no_optin_timestamp'; }\nelse if (nowMs - new Date(m.dm_optin_at).getTime() < graceMs) { eligible = false; why = 'within_optin_grace'; }\nelse if (m.last_dm_at && (nowMs - new Date(m.last_dm_at).getTime()) < cadenceMs) { eligible = false; why = 'within_cadence'; }\n\nconst name = esc(String(m.full_name || '').trim().split(' ')[0] || 'صديقنا');\nconst dmCount = Number(m.dm_count || 0);\nconst delta = pct - Number(m.prev_percent || 0);\n\nlet body;\nif (pct === 0) {\n  body = 'لاحظنا إنك ما بدأت الدورة بعد.\\nأول درس ما ياخذ منك أكثر من عشر دقايق — ابدأ فيه اليوم.';\n} else if (pct < 50) {\n  body = 'أنجزت ' + ar(pct) + '٪ من الدورة — أنت في بداية الطريق.\\nكمّل درسين بس هالأسبوع وبتلاحظ الصورة تتضح.';\n} else if (pct < 75) {\n  body = 'أنجزت ' + ar(pct) + '٪ — تجاوزت نص الدورة، وهذا أصعب جزء.\\nاللي باقي أقل من اللي سويته، لا توقف الحين.';\n} else {\n  body = 'أنجزت ' + ar(pct) + '٪ — باقي لك القليل عشان تخلّص الدورة كاملة.\\nجلسة وحدة وتنهيها.';\n}\n\nlet deltaLine = '';\nif (dmCount > 0) {\n  if (delta > 0) {\n    deltaLine = '\\n\\nتقدّمت ' + ar(delta) + '٪ من آخر مرة راسلناك — استمر 👏';\n  } else if (delta === 0) {\n    deltaLine = '\\n\\nمكانك نفسه من آخر مرة — درس واحد بس يحرّك الرقم.';\n  }\n}\n\nreturn { json: {\n  row_id: m.row_id,\n  teachable_user_id: m.teachable_user_id,\n  chat_id: m.telegram_chat_id,\n  batch: m.batch,\n  progress_fetched: fetched,\n  percent_complete: pct,\n  prev_percent: Number(m.prev_percent || 0),\n  ever_finished: everFinished,\n  dm_eligible: eligible,\n  dm_reason: why,\n  should_send: eligible && !dryRun,\n  dry_run: dryRun,\n  dm_count: dmCount,\n  text: 'هلا ' + name + ' 👋\\n\\n' + body + deltaLine\n}};\n"
      },
